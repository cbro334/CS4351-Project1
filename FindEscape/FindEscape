
package FindEscape;

import Absyn.*;
import Symbol.Symbol;
import Symbol.Table;

/**
 * Marks C variables whose addresses are taken or that are declared volatile.
 */
public class FindEscape {
    private final Table environment = new Table();

    public FindEscape(ProgramNode program) {
        if (program == null) {
            return;
        }

        environment.beginScope();
        traverseDeclarations(program.declarations);
        environment.endScope();
    }

    private void traverseDeclarations(DecList declarations) {
        for (DecList current = declarations;
             current != null;
             current = current.tail) {
            traverseDeclaration(current.head);
        }
    }

    private void traverseDeclaration(Dec declaration) {
        if (declaration instanceof VarDecl) {
            VarDecl variable = (VarDecl) declaration;

            variable.escape = hasVolatileModifier(variable.modifiers);
            environment.put(variable.name, new EscapeEntry(variable));
            traverseExpression(variable.initializer);

        } else if (declaration instanceof FunDecl) {
            traverseFunction((FunDecl) declaration);

        } else if (declaration instanceof EnumDecl) {
            EnumDecl enumeration = (EnumDecl) declaration;
            traverseExpressions(enumeration.members);
        }
    }

    private void traverseFunction(FunDecl function) {
        environment.beginScope();

        for (ExpList current = function.parameters;
             current != null;
             current = current.tail) {

            if (current.head instanceof ParamExp) {
                ParamExp parameter = (ParamExp) current.head;

                parameter.escape = false;
                environment.put(
                    Symbol.symbol(parameter.name),
                    new EscapeEntry(parameter)
                );
            }
        }

        traverseStatement(function.body);
        environment.endScope();
    }

    private boolean hasVolatileModifier(ExpList modifiers) {
        for (ExpList current = modifiers;
             current != null;
             current = current.tail) {

            if (current.head instanceof FieldExp
                    && "volatile".equals(
                        ((FieldExp) current.head).name)) {
                return true;
            }
        }

        return false;
    }

    private void traverseStatement(Stm statement) {
        if (statement instanceof CompoundStm) {
            CompoundStm compound = (CompoundStm) statement;

            environment.beginScope();

            traverseDeclarations(compound.declarations);

            for (StmList current = compound.statements;
                 current != null;
                 current = current.tail) {
                traverseStatement(current.head);
            }

            environment.endScope();

        } else if (statement instanceof ExpStm) {
            traverseExpression(((ExpStm) statement).exp);

        } else if (statement instanceof ReturnStm) {
            traverseExpression(((ReturnStm) statement).value);

        } else if (statement instanceof IfStm) {
            IfStm conditional = (IfStm) statement;

            traverseExpression(conditional.condition);
            traverseStatement(conditional.thenStm);
            traverseStatement(conditional.elseStm);

        } else if (statement instanceof WhileStm) {
            WhileStm loop = (WhileStm) statement;

            traverseExpression(loop.condition);
            traverseStatement(loop.body);

        } else if (statement instanceof DoWhileStm) {
            DoWhileStm loop = (DoWhileStm) statement;

            traverseStatement(loop.body);
            traverseExpression(loop.condition);

        } else if (statement instanceof ForLoop) {
            ForLoop loop = (ForLoop) statement;

            environment.beginScope();

            traverseStatement(loop.initialization);
            traverseStatement(loop.condition);
            traverseExpression(loop.increment);
            traverseStatement(loop.body);

            environment.endScope();
        }
    }

    private void traverseExpression(Exp expression) {
        if (expression instanceof VarExp) {
            traverseVariable(((VarExp) expression).var);

        } else if (expression instanceof UnaryOpExp) {
            UnaryOpExp unary = (UnaryOpExp) expression;

            if (unary.oper == UnaryOpExp.ADDR_OF) {
                markAddressTaken(unary.exp);
            }

            traverseExpression(unary.exp);

        } else if (expression instanceof AssignExp) {
            AssignExp assignment = (AssignExp) expression;

            traverseVariable(assignment.var);
            traverseExpression(assignment.target);
            traverseExpression(assignment.exp);

        } else if (expression instanceof CallExp) {
            CallExp call = (CallExp) expression;

            traverseExpression(call.callee);
            traverseExpressions(call.args);

        } else if (expression instanceof OpExp) {
            OpExp operation = (OpExp) expression;

            traverseExpression(operation.left);
            traverseExpression(operation.right);

        } else if (expression instanceof CondExp) {
            CondExp conditional = (CondExp) expression;

            traverseExpression(conditional.condition);
            traverseExpression(conditional.thenExp);
            traverseExpression(conditional.elseExp);

        } else if (expression instanceof ParenExp) {
            traverseExpression(((ParenExp) expression).inner);

        } else if (expression instanceof CastExp) {
            traverseExpression(((CastExp) expression).expression);

        } else if (expression instanceof ArrayRefExp) {
            ArrayRefExp array = (ArrayRefExp) expression;

            traverseExpression(array.array);
            traverseExpression(array.index);

        } else if (expression instanceof MemberExp) {
            traverseExpression(((MemberExp) expression).target);

        } else if (expression instanceof ArrayExp) {
            ArrayExp array = (ArrayExp) expression;

            traverseExpression(array.size);
            traverseExpression(array.init);

        } else if (expression instanceof ArrayInitExp) {
            traverseExpressions(((ArrayInitExp) expression).elements);

        } else if (expression instanceof RecordExp) {
            FieldExpList fields = ((RecordExp) expression).fields;

            for (; fields != null; fields = fields.tail) {
                traverseExpression(fields.init);
            }

        } else if (expression instanceof EnumMemberExp) {
            traverseExpression(((EnumMemberExp) expression).value);
        }

        // Literals and sizeof expressions have no evaluated child expressions.
    }

    private void traverseExpressions(ExpList expressions) {
        for (ExpList current = expressions;
             current != null;
             current = current.tail) {
            traverseExpression(current.head);
        }
    }

    private void traverseVariable(Var variable) {
        if (variable instanceof FieldVar) {
            traverseVariable(((FieldVar) variable).var);

        } else if (variable instanceof SubscriptVar) {
            SubscriptVar subscript = (SubscriptVar) variable;

            traverseVariable(subscript.var);
            traverseExpression(subscript.index);
        }
    }

    private void markAddressTaken(Exp expression) {
        if (expression instanceof ParenExp) {
            markAddressTaken(((ParenExp) expression).inner);

        } else if (expression instanceof VarExp) {
            markAddressTaken(((VarExp) expression).var);

        } else if (expression instanceof ArrayRefExp) {
            markAddressTaken(((ArrayRefExp) expression).array);

        } else if (expression instanceof MemberExp) {
            markAddressTaken(((MemberExp) expression).target);
        }
    }

    private void markAddressTaken(Var variable) {
        if (variable instanceof SimpleVar) {
            Object entry = environment.get(
                ((SimpleVar) variable).name
            );

            if (entry instanceof EscapeEntry) {
                ((EscapeEntry) entry).mark();
            }

        } else if (variable instanceof FieldVar) {
            markAddressTaken(((FieldVar) variable).var);

        } else if (variable instanceof SubscriptVar) {
            markAddressTaken(((SubscriptVar) variable).var);
        }
    }

    private static class EscapeEntry {
        private final VarDecl variable;
        private final ParamExp parameter;

        EscapeEntry(VarDecl variable) {
            this.variable = variable;
            this.parameter = null;
        }

        EscapeEntry(ParamExp parameter) {
            this.variable = null;
            this.parameter = parameter;
        }

        void mark() {
            if (variable != null) {
                variable.escape = true;
            }

            if (parameter != null) {
                parameter.escape = true;
            }
        }
    }
}
