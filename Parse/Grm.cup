package Parse;

action code {: static Symbol.Symbol sym(String s) {
        return Symbol.Symbol.symbol(s);
    	  }
	  :};

parser code  {: 
  Lexer lexer;

  public void syntax_error(java_cup.runtime.Symbol current) {
     report_error("Syntax error (" + current.sym + ")", current);
  }

  ErrorMsg.ErrorMsg errorMsg;

  public void report_error(String message, java_cup.runtime.Symbol info) {
      errorMsg.error(info.left, message);
  }

  public Grm(Lexer l, ErrorMsg.ErrorMsg err) {
    this();
    errorMsg=err;
    lexer=l;
  }
:};

scan with {: return lexer.nextToken(); :};

//Terminals:
terminal String ID, STRING;
terminal Integer INT;
terminal COMMA, COLON, SEMICOLON, LPAREN, RPAREN, LBRACK, RBRACK, 
	LBRACE, RBRACE, DOT, PLUS, MINUS, TIMES, DIVIDE, EQ, NEQ, LT, LE, 
	GT, GE, AND, OR, ASSIGN, ARRAY, IF, THEN, ELSE, WHILE, FOR, TO,
	DO, LET, IN, END, OF, BREAK, NIL, FUNCTION, VAR, TYPE;

//Added Terminals:
terminal FUN, RETURN, CONTINUE, NOT, INC, DEC, ARROW;
terminal PLUS_ASSIGN, MINUS_ASSIGN, TIMES_ASSIGN, DIVIDE_ASSIGN, MOD, QMARK;

//Non-Terminals: (Exp was replaced with Program to reduce confusion with Expressions in C89 documentation)
non terminal Absyn.Absyn          Program;
non terminal Absyn.Stm            Statement, Compound_statement, Expression_statement, Selection_statement, Iteration_statement, Jump_statement;
non terminal Absyn.Exp            Expression, Assignment_expression, Conditional_expression, Logical_or_expression, Logical_and_expression;
non terminal Absyn.Exp            Equality_expression, Relational_expression, Additive_expression, Multiplicative_expression;
non terminal Absyn.Exp            Unary_expression, Postfix_expression, Primary_expression;
non terminal Absyn.ExpList        Argument_expression_list, Statement_list, Declaration_list;

non terminal Absyn.Stm            Declaration, Var_declaration, Fun_declaration;
non terminal Absyn.ExpList        Bitfield_list, Parameters, Parameter_list;
non terminal String               Type, Type_name, Type_augments;
non terminal Absyn.Exp            Initialization;

start with program;

Program ::= Declaration_list:dl {: RESULT = dl; :};

//Declaration:
Declaration_list ::= declaration:d declaration_list:dl 
{: RESULT = new ExpList(dleft, d, dl); :};

Declaration ::= var_declaration:v {: RESULT = v; :}
              | fun_declaration:f {: RESULT = f; :};

Var_declaration ::= VAR bitfield_list:bl type:t IDENTIFIER:id initialization:i SEMICOLON {: RESULT = new VarDecl(VARleft, bl, t, Symbol.symbol(id), i); :};

Fun_declaration ::= FUN bitfield_list:bl type:t IDENTIFIER:id LPAR parameters:p RPAR compound_statement:cs {: RESULT = new FunDecl(FUNleft, bl, t, Symbol.symbol(id), p, cs); :};

Bitfield_list ::= IDENTIFIER:id bitfield_list:bl {: RESULT = new ExpList(idleft, new FieldExp(idleft, id), bl); :}

Type ::= type_name:tn type_augments:ta            {: RESULT = tn + ta; :}
       | type_name:tn                             {: RESULT = tn; :};

Type_name ::= IDENTIFIER:id                       {: RESULT = id; :};

Type_augments ::= MUL type_augments:ta            {: RESULT = "*" + ta; :}
                | LBRACK RBRACK type_augments:ta   {: RESULT = "[]" + ta; :}
                | LBRACK INT_LITERAL:i RBRACK type_augments:ta {: RESULT = "[" + i + "]" + ta; :}
                | MUL                             {: RESULT = "*"; :}
                | LBRACK RBRACK                   {: RESULT = "[]"; :}
                | LBRACK INT_LITERAL:i RBRACK      {: RESULT = "[" + i + "]"; :};

Parameters ::= parameter_list:pl                 {: RESULT = pl; :}

Parameter_list ::= type:t IDENTIFIER:id COMMA parameter_list:pl {: RESULT = new ExpList(tleft, new ParamExp(tleft, t, id), pl); :}
                 | type:t IDENTIFIER:id                         {: RESULT = new ExpList(tleft, new ParamExp(tleft, t, id), null); :};

Initialization ::= ASSIGN assignment_expression:e {: RESULT = e; :}

//Statements:
Statement ::= compound_statement:s   {: RESULT = s; :}
            | expression_statement:s {: RESULT = s; :}
            | selection_statement:s  {: RESULT = s; :}
            | iteration_statement:s  {: RESULT = s; :}
            | jump_statement:s       {: RESULT = s; :};

Compound_statement ::= LBRACE declaration_list:dl statement_list:sl RBRACE {: RESULT = new CompoundStm(LBRACEleft, dl, sl); :};

Statement_list ::= statement:s statement_list:sl {: RESULT = new ExpList(sleft, s, sl); :}

Expression_statement ::= expression:e SEMICOLON  {: RESULT = new ExpStm(eleft, e); :}
                       | SEMICOLON               {: RESULT = null; :};

Selection_statement ::= IF LPAR expression:e RPAR statement:s1 ELSE statement:s2 {: RESULT = new IfStm(IFleft, e, s1, s2); :}
                      | IF LPAR expression:e RPAR statement:s {: RESULT = new IfStm(IFleft, e, s, null); :};

Iteration_statement ::= WHILE LPAR expression:e RPAR statement:s {: RESULT = new WhileStm(WHILEleft, e, s); :}
                      | DO statement:s WHILE LPAR expression:e RPAR SEMICOLON {: RESULT = new DoWhileStm(DOleft, s, e); :}
                      | FOR LPAR expression_statement:init expression_statement:check expression:inc RPAR statement:s {: RESULT = new ForLoop(FORleft, init, check, inc, s); :};

Jump_statement ::= CONTINUE SEMICOLON            {: RESULT = new ContinueStm(CONTINUEleft); :}
                 | BREAK SEMICOLON               {: RESULT = new BreakStm(BREAKleft); :}
                 | RETURN expression:e SEMICOLON {: RESULT = new ReturnStm(RETURNleft, e); :}
                 | RETURN SEMICOLON              {: RESULT = new ReturnStm(RETURNleft, null); :};

//Expressions:
Expression ::= assignment_expression:e          {: RESULT = e; :}
             | expression:e COMMA assignment_expression:ae {: RESULT = new OpExp(eleft, e, OpExp.COMMA, ae); :};

Assignment_expression ::= conditional_expression:e {: RESULT = e; :}
                        | unary_expression:lhs ASSIGN assignment_expression:rhs {: RESULT = new AssignExp(lhsleft, lhs, AssignExp.ASSIGN, rhs); :}
                        | unary_expression:lhs PLUS_ASSIGN assignment_expression:rhs {: RESULT = new AssignExp(lhsleft, lhs, AssignExp.PLUS_ASSIGN, rhs); :}
                        | unary_expression:lhs MINUS_ASSIGN assignment_expression:rhs {: RESULT = new AssignExp(lhsleft, lhs, AssignExp.MINUS_ASSIGN, rhs); :};

Conditional_expression ::= logical_or_expression:e {: RESULT = e; :}
                         | logical_or_expression:cond QMARK expression:trueExp COLON conditional_expression:falseExp {: RESULT = new CondExp(condleft, cond, trueExp, falseExp); :};

Logical_or_expression ::= logical_and_expression:e {: RESULT = e; :}
                        | logical_or_expression:l OR logical_and_expression:r {: RESULT = new OpExp(lleft, l, OpExp.OR, r); :};

Logical_and_expression ::= equality_expression:e {: RESULT = e; :}
                         | logical_and_expression:l AND equality_expression:r {: RESULT = new OpExp(lleft, l, OpExp.AND, r); :};

Equality_expression ::= relational_expression:e {: RESULT = e; :}
                      | equality_expression:l EQ relational_expression:r {: RESULT = new OpExp(lleft, l, OpExp.EQ, r); :}
                      | equality_expression:l NEQ relational_expression:r {: RESULT = new OpExp(lleft, l, OpExp.NEQ, r); :};

Relational_expression ::= additive_expression:e {: RESULT = e; :}
                        | relational_expression:l LT additive_expression:r  {: RESULT = new OpExp(lleft, l, OpExp.LT, r); :}
                        | relational_expression:l GT additive_expression:r  {: RESULT = new OpExp(lleft, l, OpExp.GT, r); :}
                        | relational_expression:l LE additive_expression:r  {: RESULT = new OpExp(lleft, l, OpExp.LE, r); :}
                        | relational_expression:l GE additive_expression:r  {: RESULT = new OpExp(lleft, l, OpExp.GE, r); :};

Additive_expression ::= multiplicative_expression:e {: RESULT = e; :}
                      | additive_expression:l PLUS multiplicative_expression:r  {: RESULT = new OpExp(lleft, l, OpExp.PLUS, r); :}
                      | additive_expression:l MINUS multiplicative_expression:r {: RESULT = new OpExp(lleft, l, OpExp.MINUS, r); :};

Multiplicative_expression ::= unary_expression:e {: RESULT = e; :}
                            | multiplicative_expression:l MUL unary_expression:r {: RESULT = new OpExp(lleft, l, OpExp.MUL, r); :}
                            | multiplicative_expression:l DIV unary_expression:r {: RESULT = new OpExp(lleft, l, OpExp.DIV, r); :}
                            | multiplicative_expression:l MOD unary_expression:r {: RESULT = new OpExp(lleft, l, OpExp.MOD, r); :};

Unary_expression ::= postfix_expression:e {: RESULT = e; :}
                   | INC unary_expression:e   {: RESULT = new UnaryOpExp(INCleft, UnaryOpExp.PRE_INC, e); :}
                   | DEC unary_expression:e   {: RESULT = new UnaryOpExp(DECleft, UnaryOpExp.PRE_DEC, e); :}
                   | MINUS unary_expression:e {: RESULT = new UnaryOpExp(MINUSleft, UnaryOpExp.NEG, e); :}
                   | PLUS unary_expression:e  {: RESULT = new UnaryOpExp(PLUSleft, UnaryOpExp.POS, e); :}
                   | NOT unary_expression:e   {: RESULT = new UnaryOpExp(NOTleft, UnaryOpExp.NOT, e); :}
				   | MUL unary_expression:e   {: RESULT = new UnaryOpExp(MULleft, UnaryOpExp.DEREF, e); :}
				   | AND unary_expression:e   {: RESULT = new UnaryOpExp(ANDleft, UnaryOpExp.ADDR_OF, e); :};


Postfix_expression ::= primary_expression:e {: RESULT = e; :}
					 | postfix_expression:e LBRACK expression:index RBRACK {: RESULT = new ArrayRefExp(eleft, e, index); :}
					 | postfix_expression:e LPAR argument_expression_list:args RPAR {: RESULT = new CallExp(eleft, e, args); :}
					 | postfix_expression:e DOT IDENTIFIER:id {: RESULT = new MemberExp(eleft, e, Symbol.symbol(id), false); :}
				     | postfix_expression:e ARROW IDENTIFIER:id {: RESULT = new MemberExp(eleft, e, Symbol.symbol(id), true); :}
					 | postfix_expression:e INC {: RESULT = new UnaryOpExp(eleft, UnaryOpExp.POST_INC, e); :}
					 | postfix_expression:e DEC {: RESULT = new UnaryOpExp(eleft, UnaryOpExp.POST_DEC, e); :};

Argument_expression_list ::= assignment_expression:e COMMA argument_expression_list:el {: RESULT = new ExpList(eleft, e, el); :}
						   | assignment_expression:e {: RESULT = new ExpList(eleft, e, null); :}

Primary_expression ::= IDENTIFIER:id {: RESULT = new VarExp(idleft, Symbol.symbol(id));细 :}
					 | INT_LITERAL:val   {: RESULT = new IntExp(valleft, val); :}
					 | STRING_LITERAL:s  {: RESULT = new StringExp(sleft, s); :}
					 | LPAR expression:e RPAR {: RESULT = e; :};
